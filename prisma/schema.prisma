generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Stock {
  id        String   @id @default(cuid())
  ticker    String   @unique
  name      String
  sector    String?
  industry  String?
  exchange  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fundamentals      Fundamental[]
  screenResults     ScreenResult[]
  watchlistItems    WatchlistItem[]
  portfolioItems    PortfolioItem[]
  paperPortfolio    PaperPortfolioItem[]
  intrinsicValues   IntrinsicValue[]
}

model Fundamental {
  id      String @id @default(cuid())
  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id])

  year   Int
  period String @default("annual")

  revenue             Float?
  grossProfit         Float?
  operatingIncome     Float?
  netIncome           Float?
  eps                 Float?
  epsDiluted          Float?
  dividendPerShare    Float?
  totalAssets         Float?
  totalLiabilities    Float?
  totalEquity         Float?
  bookValuePerShare   Float?
  currentAssets       Float?
  currentLiabilities  Float?
  longTermDebt        Float?
  cash                Float?
  operatingCashFlow   Float?
  capitalExpenditures Float?
  freeCashFlow        Float?
  depreciation        Float?
  pe                  Float?
  pb                  Float?
  debtToEquity        Float?
  currentRatio        Float?
  roe                 Float?
  roic                Float?
  ownerEarnings       Float?
  price               Float?
  marketCap           Float?
  sharesOutstanding   Float?

  fetchedAt DateTime @default(now())

  @@unique([stockId, year, period])
  @@index([stockId])
}

model IntrinsicValue {
  id      String @id @default(cuid())
  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id])

  calculatedAt     DateTime @default(now())
  currentPrice     Float
  grahamNumber     Float?
  dcfValue         Float?
  intrinsicValue   Float
  marginOfSafety   Float
  isBuySignal      Boolean  @default(false)
  ownerEarnings    Float?
  growthRateUsed   Float?
  discountRateUsed Float?
  terminalGrowth   Float?

  @@index([stockId])
}

model ScreenResult {
  id      String @id @default(cuid())
  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id])

  screenedAt          DateTime @default(now())
  passedPE            Boolean
  passedPB            Boolean
  passedCurrentRatio  Boolean
  passedDebtToAssets  Boolean
  passedEpsGrowth     Boolean
  passedDividends     Boolean
  passedNoDeficit     Boolean
  overallPass         Boolean
  peValue             Float?
  pbValue             Float?
  currentRatioValue   Float?
  debtToAssetsValue   Float?
  epsGrowthValue      Float?
  dividendYears       Int?

  @@index([stockId])
  @@index([overallPass])
}

model WatchlistItem {
  id              String    @id @default(cuid())
  stockId         String    @unique
  stock           Stock     @relation(fields: [stockId], references: [id])
  addedAt         DateTime  @default(now())
  targetPrice     Float?
  notes           String?
  isActive        Boolean   @default(true)
  // Last analysis snapshot — shows why a stock keeps getting skipped
  lastScore       Int?
  lastMos         Float?
  lastAction      String?   // 'SKIP' | 'VETOED' | 'PAPER_BUY' | 'QUEUED_LIVE'
  lastSkipReason  String?
  lastAnalyzedAt  DateTime?

  @@index([lastScore])
  @@index([isActive, lastScore])
}

model PortfolioItem {
  id              String   @id @default(cuid())
  stockId         String
  stock           Stock    @relation(fields: [stockId], references: [id])
  shares          Float
  avgCostBasis    Float
  firstPurchased  DateTime
  lastUpdated     DateTime @updatedAt
  schwabAccountId String?
  schwabOrderIds  String[] @default([])
  notes           String?

  @@index([stockId])
}

// Paper trading — simulated positions, never touches Schwab
model PaperPortfolioItem {
  id              String   @id @default(cuid())
  stockId         String
  stock           Stock    @relation(fields: [stockId], references: [id])
  shares          Float
  avgCostBasis    Float
  currentPrice    Float?
  firstPurchased  DateTime @default(now())
  lastUpdated     DateTime @updatedAt
  philosophyScore Int?
  conviction      String?
  mosAtPurchase   Float?
  auditTrail      String[] @default([])
  dividendsEarned Float    @default(0)
  isOpen          Boolean  @default(true)
  closedAt        DateTime?
  closePrice      Float?
  closeReason     String?

  @@index([stockId])
  @@index([isOpen])
}

// Persists autopilot settings server-side (mode, thresholds)
model AutopilotConfig {
  id                String   @id @default("singleton")
  isEnabled         Boolean  @default(true)
  mode              String   @default("paper")   // "paper" | "live"
  minPhilosophyScore Int     @default(45)
  minMarginOfSafety  Float   @default(15)
  maxPositionPct     Float   @default(10)
  totalCapital       Float   @default(10000)
  maxPositions       Int     @default(15)
  discountRate       Float   @default(10)    // DCF discount rate in % (e.g. 10 = 10%)
  minCashReservePct  Float   @default(15)    // minimum % of totalCapital to keep in cash
  maxSectorPct       Float   @default(30)    // max % of capital in any single sector
  autoDiscovery      Boolean @default(true)  // auto-discover value stocks via Yahoo screener on full runs
  dailyAnalysisLimit Int     @default(25)    // max watchlist items analyzed per run (manual items always included; rest rotate)
  schwabAccountId   String?
  lastRunAt         DateTime?
  lastRunResult     Json?
  updatedAt         DateTime @updatedAt
  maxDailyTrades    Int      @default(10)    // max paper/live buys per day
  maxDailyNotional  Float    @default(5000)  // max $ deployed in a single day
  maxSingleNotional Float    @default(2000)  // max $ for a single trade
  dailyRundown      String?                  // AI-generated market rundown from last run
}

model MoatAnalysis {
  id              String   @id @default(cuid())
  ticker          String
  stockId         String?
  companyName     String
  generatedAt     DateTime @default(now())
  moatScore       Float
  moatType        String
  moatSources     String[] @default([])
  managementScore Float
  businessQuality String
  thesis          String
  keyRisks        String[] @default([])
  catalysts       String[] @default([])
  verdict         String
  confidence      Float
  quantScore      Int?
  mosAtAnalysis   Float?

  @@index([ticker])
  @@index([generatedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String   // e.g. 'autopilot_run', 'config_change', 'paper_buy', 'paper_sell'
  actor     String   @default("system") // 'cron', 'ui', 'system'
  details   Json?

  @@index([createdAt])
  @@index([action])
}

model SchwabToken {
  id           String   @id @default(cuid())
  accountId    String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Alert {
  id        String   @id @default(cuid())
  stockId   String?
  ticker    String
  type      String
  message   String
  severity  String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model QuarterlyRebalance {
  id         String   @id @default(cuid())
  executedAt DateTime @default(now())
  notes      String?
  actions    Json
}

// Persistent score leaderboard — every stock scored by scanner or autopilot lands here.
// One row per ticker (upserted), always reflects the latest run.
// The screener Score Board and autopilot buy logic both read from this table.
model StockScore {
  id             String   @id @default(cuid())
  ticker         String   @unique
  name           String?
  sector         String?
  price          Float
  score          Int      // 0–100 philosophy score
  mos            Float    // margin of safety %
  intrinsicValue Float?
  grahamNumber   Float?
  pe             Float?
  pb             Float?
  signal         String   // BUY | PASS | HOLD
  conviction     String?  // exceptional | strong_buy | buy | watchlist | avoid
  vetoCount      Int      @default(0)
  vetoReasons    String[] @default([])
  source         String   @default("scan") // "scan" | "autopilot"
  scoredAt       DateTime @default(now())

  @@index([score])
  @@index([signal])
  @@index([scoredAt])
}

model PortfolioSnapshot {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  totalValue Float
  totalCost  Float
  gainLossPct Float
  spyPrice   Float?
  positions  Json

  @@index([date])
}
